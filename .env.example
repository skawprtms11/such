# Supabase 연동 설정. 이 파일을 복사해 .env.local 을 만들고 값을 채운다.
# VITE_ 접두사가 붙은 값만 프론트엔드 코드에서 읽을 수 있다.
# ⚠️ .env.local 은 git 에 올라가지 않는다. 키를 소스에 하드코딩하지 않는다.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 공개(publishable) 키. 정적 파일에 그대로 담기므로 비밀이 아니다.
# 실제 접근 제어는 서버의 RLS 정책이 한다. (supabase/schema.sql 참고)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# 데이터 소스: mock | supabase
#   mock     - localStorage + 샘플 데이터 (서버 없이 화면만 확인할 때)
#   supabase - 실제 서버 (로그인은 이메일 + 비밀번호)
VITE_DATA_SOURCE=supabase
